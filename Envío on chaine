import math
from collections import defaultdict


ARCHIVO = "grafo.txt"


def cargar_grafo():

    grafo = defaultdict(set)
    inverso = defaultdict(set)

    with open(
        ARCHIVO,
        "r",
        encoding="utf-8"
    ) as f:

        for linea in f:

            partes = linea.strip().split()

            if len(partes) != 2:
                continue

            a,b = partes

            grafo[a].add(b)
            inverso[b].add(a)


    return grafo, inverso



def centralidad(grafo, inverso):

    nodos = set(
        grafo.keys()
    )

    nodos.update(
        inverso.keys()
    )


    resultado = []


    for n in nodos:

        salida = len(
            grafo[n]
        )

        entrada = len(
            inverso[n]
        )


        # peso Tapiz simple:
        # conexiones + equilibrio entrada/salida

        energia = math.sqrt(
            salida**2 +
            entrada**2
        )


        equilibrio = (
            min(salida,entrada)
            /
            max(
                salida,
                entrada,
                1
            )
        )


        central = (
            energia *
            (1 + equilibrio)
        )


        resultado.append(
            (
                central,
                n,
                entrada,
                salida
            )
        )


    return sorted(
        resultado,
        reverse=True
    )



def main():

    grafo,inverso = cargar_grafo()


    ranking = centralidad(
        grafo,
        inverso
    )


    print("=== RANKING NODOS CENTRALES ===")
    print()


    for i,x in enumerate(
        ranking[:50],
        1
    ):

        valor,n,entrada,salida = x

        print(
            i,
            n,
            "C=",
            round(valor,3),
            "IN=",
            entrada,
            "OUT=",
            salida
        )



if __name__ == "__main__":
    main()
